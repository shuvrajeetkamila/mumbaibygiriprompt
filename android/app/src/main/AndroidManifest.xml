<?xml version="1.0" encoding="utf-8"?>
<!--
  MUMBAI 1:1 EXACT — the client's manifest.

  `android:hasCode="false"`: there is no dex in this APK.  The activity is the
  platform's own `android.app.NativeActivity`, which owns the surface and hands it
  to `ANativeActivity_onCreate` in libmumbai.so.  A Java activity would add a
  dependency tree and a second language between the debugger and the crash.

  Vulkan 1.1 is *required* rather than requested: the renderer has no fallback
  path and a device without it would install an app that cannot draw.  Saying so
  in the manifest means the store — and `adb install` — refuses up front.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:label="Mumbai 1:1"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="Mumbai 1:1"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="mumbai" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
