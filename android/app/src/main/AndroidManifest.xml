<?xml version="1.0" encoding="utf-8"?>
<!--
  MUMBAI 1:1 EXACT — the client's manifest.

  THE ACTIVITY IS THE PLATFORM'S OWN `android.app.NativeActivity`: it owns the
  surface and hands it to `ANativeActivity_onCreate` in libmumbai.so, with no
  activity of this app's own, no AndroidX, and no lifecycle to get wrong.

  THERE IS EXACTLY ONE JAVA CLASS (com.mumbai.exact.WorldFetch), so
  `android:hasCode` is true and the APK has a small dex.  That class is the city
  download's transport: it exists because HTTPS on Android lives in Java, with a
  certificate store that is actually maintained, and the engine has no TLS stack and
  will not grow one (D-048).  It does one thing — a byte-range GET that hands its
  chunks to the C++ downloader — and it verifies nothing, because the downloader
  verifies every byte it writes.

  INTERNET: without it the download fails with a permission error at the first
  request, which is exactly the kind of failure that is invisible until a person taps
  the button on a phone.

  Vulkan 1.1 is *required* rather than requested: the renderer has no fallback
  path and a device without it would install an app that cannot draw.  Saying so
  in the manifest means the store — and `adb install` — refuses up front.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- The rest of the city is a download (D-048).  The APK itself works offline:
         South Bombay travels inside it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Mumbai 1:1"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="Mumbai 1:1"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="mumbai" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
