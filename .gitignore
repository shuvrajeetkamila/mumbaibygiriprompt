# ---- Build outputs ----
build/
*.o
*.a

# ---- Generated world data (regenerate with `make world`) ----
data/processed/
data/raw/

# ---- Node / viewer ----
node_modules/
npm-debug.log*
.viewer-cache/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# Android/Gradle build output and machine-local SDK paths.  local.properties is
# written by whoever opens the project (it holds sdk.dir); CI sets ANDROID_HOME.
android/local.properties
android/.gradle/
android/app/build/
android/app/.cxx/
android/build/
*.apk
*.aab

# The starter world is packed by tools/make_starter_world.py from `make world`'s
# output, so it is derived data and does not belong in the repository: 96 MiB of
# chunks and a texture array that the pipeline regenerates byte-identically.
android/app/src/main/assets/world/
engine/world/world_release.generated.h
