# ---- Build outputs ----
build/
*.o
*.a

# ---- Generated world data (regenerate with `make world`) ----
data/processed/
data/raw/

# ---- Node / viewer ----
node_modules/
npm-debug.log*
.viewer-cache/

# ---- Python bytecode ----
# A committed .pyc is a machine-specific artifact that also *masks* a source change:
# the interpreter loads the stale bytecode and the tool keeps behaving like its old
# self.  One got swept into a commit by `git add -A`; the pattern is here so the
# next `git add -A` cannot do it again.
__pycache__/
*.pyc

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# Android/Gradle build output and machine-local SDK paths.  local.properties is
# written by whoever opens the project (it holds sdk.dir); CI sets ANDROID_HOME.
android/local.properties
android/.gradle/
android/app/build/
android/app/.cxx/
android/build/
*.apk
*.aab

# The starter world is packed by tools/make_starter_world.py from `make world`'s
# output, so it is derived data and does not belong in the repository: 96 MiB of
# chunks and a texture array that the pipeline regenerates byte-identically.
android/app/src/main/assets/world/
engine/world/world_release.generated.h
